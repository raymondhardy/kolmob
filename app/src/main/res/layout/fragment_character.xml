<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Character Panel -->
        <TextView
            android:id="@+id/tab_char"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Character"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/char_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hero"
            android:textSize="16sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/char_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 12"
            android:textSize="14sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/char_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HP: 100 | MP: 50 | XP: 5000"
            android:textSize="14sp"
            android:textColor="@android:color/white" />

        <!-- Inventory Panel -->
        <TextView
            android:id="@+id/tab_inv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inventory"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/inv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="125 items"
            android:textSize="14sp"
            android:textColor="@android:color/white" />

        <!-- Skills Panel -->
        <TextView
            android:id="@+id/tab_skill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skills"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <!-- Tools Panel -->
        <TextView
            android:id="@+id/tab_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tools"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <!-- Extra Buttons -->
        <TextView
            android:id="@+id/tab_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extra"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <!-- Action Button -->
        <Button
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh Data" />

    </LinearLayout>
</ScrollView>