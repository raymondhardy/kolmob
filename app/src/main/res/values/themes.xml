<resources>
    <style name="Theme.Kolmob" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:alertDialogTheme">@style/Kolmob.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Kolmob.MaterialAlertDialog</item>
        <item name="bottomNavigationStyle">@style/Widget.Kolmob.BottomNavigationView</item>
    </style>

    <style name="Widget.Kolmob.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Kolmob.BottomNavigationView.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Kolmob.BottomNavigationView.Inactive</item>
    </style>

    <style name="TextAppearance.Kolmob.BottomNavigationView.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Kolmob.BottomNavigationView.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bottom_nav_inactive</item>
    </style>

    <!-- Dialogs with a text box open with the keyboard up. Same look as the platform default, plus the keyboard rule. -->
    <style name="Kolmob.AlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowSoftInputMode">stateVisible|adjustResize</item>
    </style>
    <style name="Kolmob.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowSoftInputMode">stateVisible|adjustResize</item>
    </style>

    <style name="ChatPanelAnim">
        <item name="android:windowEnterAnimation">@anim/chat_panel_in</item>
        <item name="android:windowExitAnimation">@anim/chat_panel_out</item>
    </style>

    <style name="FullScreenDialogStyle" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:alertDialogTheme">@style/Kolmob.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/Kolmob.MaterialAlertDialog</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
    </style>
</resources>