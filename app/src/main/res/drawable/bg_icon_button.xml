<?xml version="1.0" encoding="utf-8"?>
<!-- Button chrome for icon-only controls: a rounded, outlined tile with a ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#554CAF50">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/overlayFill" />
            <stroke android:width="1dp" android:color="@color/overlayStroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
