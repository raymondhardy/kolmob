<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.MaterialComponents.NoActionBar"
        android:background="@color/colorPrimaryVariant">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/editor_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimaryVariant"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@android:color/white"
            app:title="@string/scripts_new"
            app:titleTextColor="@android:color/white"
            app:menu="@menu/editor_menu" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Find bar (initially hidden) -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/colorSurface"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find:"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/find_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search..."
            android:textColor="@color/colorOnSurface"
            android:textColorHint="@color/bottom_nav_inactive"
            android:textSize="14sp"
            android:background="@drawable/bg_search_input"
            android:padding="8dp" />

        <Button
            android:id="@+id/find_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/find_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/find_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Editor with line numbers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.example.kolmafiaandroid.ui.LineNumberView
            android:id="@+id/line_numbers"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/colorPrimaryVariant"
            android:gravity="top" />

        <EditText
            android:id="@+id/script_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="@color/colorOnBackground"
            android:textColorHint="@color/bottom_nav_inactive"
            android:hint="@string/scripts_file_name_hint"
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:scrollbars="vertical"
            android:overScrollMode="always" />

    </LinearLayout>

</LinearLayout>