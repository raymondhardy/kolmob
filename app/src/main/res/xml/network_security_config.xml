<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- KoLmafia's relay server (the in-game browser proxy) listens on localhost over plain HTTP. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">kingdomofloathing.com</domain>
        <domain includeSubdomains="true">api.kingdomofloathing.com</domain>
        <domain includeSubdomains="true">kolmafia.us</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>